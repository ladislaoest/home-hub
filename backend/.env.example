# --- Seguridad ---
# Usuario y contraseña para entrar en tu HomeHub (obligatorio, la app queda expuesta en internet)
ADMIN_USER=ladis
ADMIN_PASSWORD=cambia_esto_por_una_contrasena_fuerte
# Clave secreta para firmar las sesiones (genera una aleatoria larga)
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# --- Puerto ---
PORT=3000

# --- Voz / NLU (interpreta lo que dices y decide qué hacer) ---
# Opción gratuita recomendada: Groq (sin tarjeta). Crea una clave en https://console.groq.com/keys
GROQ_API_KEY=
# Opción de pago: Claude. Si GROQ_API_KEY está puesta, tiene prioridad sobre esta.
# Consigue una clave en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Samsung SmartThings (TV) ---
# Genera un Personal Access Token en https://account.smartthings.com/tokens
SMARTTHINGS_TOKEN=

# --- Tuya Cloud (bombillas Smart Life / Tuya / muchas genéricas) ---
# Crea un proyecto en https://iot.tuya.com/ (Cloud Development)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=eu
# UID de tu cuenta de la app Smart Life/Tuya (Tuya IoT Platform > Cloud > Devices > Link Tuya App Account)
TUYA_USER_ID=

# --- Philips Hue (opcional, si en vez de/además de Tuya usas Hue) ---
HUE_BRIDGE_USERNAME=
HUE_REMOTE_ACCESS_TOKEN=

# --- Alexa (opcional, EXPERIMENTAL, ver docs/SETUP.md) ---
ALEXA_ANNOUNCE_MODE=routine
# routine  -> usa un switch virtual de SmartThings + Rutina de Alexa (oficial, solo frases fijas)
# unofficial -> usa una librería no oficial para hablar texto libre por el Echo (bajo tu responsabilidad)
ALEXA_COOKIE=
# Dominio de tu cuenta de Amazon (donde iniciaste sesión para sacar la cookie): alexa.amazon.es, alexa.amazon.com, etc.
ALEXA_DOMAIN=alexa.amazon.es
# Opcional: si tienes varios Echo y quieres elegir uno en concreto (si no, coge el primer Echo Show, si no el primero con micrófono)
ALEXA_ANNOUNCE_DEVICE_SERIAL=
# Si creaste una skill de Alexa personalizada para hablarle directamente sin el móvil (ver docs/SETUP.md)
ALEXA_SKILL_ID=

# --- Emby (opcional, para pedir contenido concreto por nombre) ---
# URL de tu servidor Emby accesible desde fuera de casa (Emby Connect, o puerto redirigido)
EMBY_SERVER_URL=
# Panel de control > Avanzado > API Keys
EMBY_API_KEY=
